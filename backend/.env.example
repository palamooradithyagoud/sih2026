# ==============================================================================
# FastAPI Backend Environment Variables
# ==============================================================================

PROJECT_NAME="AI Criminal Investigation KG API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# CORS Origins (JSON list or comma-separated string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Connection Details
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="criminal_investigation_db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/criminal_investigation_db"

# Neo4j Graph Database Details
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="neo4jpassword"
NEO4J_DATABASE="neo4j"

# Future AI / LLM Configuration Placeholder
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
